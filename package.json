{
    "private": true,
    "workspaces": [
        "packages/*",
        "crafts/*"
    ],
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.0",
        "@mui/icons-material": "^6.4.0",
        "@mui/material": "^6.4.0",
        "@mui/system": "^7.3.5",
        "@mui/x-date-pickers": "^7.22.2",
        "@types/node": "^18",
        "@types/react": "^19",
        "@types/react-beautiful-dnd": "^13.1.8",
        "@types/react-color": "^3.0.6",
        "@types/react-dom": "^19",
        "@types/react-modal": "^3.16.3",
        "@types/react-transition-group": "^4.4.4",
        "dayjs": "^1.11.19",
        "eslint-plugin-react-hooks": "^4.3.0",
        "lodash": "^4.17.21",
        "logisheets-core": "workspace:*",
        "logisheets-engine": "workspace:*",
        "logisheets-web": "workspace:*",
        "mobx": "^6.12.3",
        "mobx-react": "^9.1.1",
        "neverthrow": "^8.2.0",
        "numfmt": "2.1.0",
        "react": "^19",
        "react-beautiful-dnd": "^13.1.1",
        "react-color": "^2.19.3",
        "react-dom": "^19",
        "react-i18next": "^11.18.3",
        "react-modal": "^3.16.3",
        "react-select": "^5.4.0",
        "react-toastify": "^11.0.2",
        "react-transition-group": "^4.4.2",
        "rxjs": "^7.8.1",
        "web-vitals": "^2.1.4"
    },
    "scripts": {
        "build-crafts": "./crafts/build.sh",
        "build": "yarn build-crafts && vite build && ./publish-crafts.sh",
        "build:games": "CRAFT_DIST=games yarn build",
        "gen-bindings": "cargo run --package buildtools --bin generate --all-features",
        "lint": "eslint . -c .eslintrc.json --fix",
        "prepare": "husky install",
        "run-scripts": "ts-node scripts/index.ts",
        "start": "yarn run start:wasm",
        "start:dev": "vite",
        "start:wasm": "yarn run run-scripts && yarn run wasm && yarn workspace logisheets-engine build && vite",
        "test": "vitest run",
        "test:e2e": "playwright test",
        "test:e2e:headed": "playwright test --headed",
        "wasm": "yarn run wasm:server",
        "wasm:server": "wasm-pack build crates/wasms/server --out-dir ../../../packages/web/wasm --target web",
        "docs:dev": "vitepress dev docs",
        "docs:build": "vitepress build docs",
        "docs:preview": "vitepress preview docs"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "devDependencies": {
        "@playwright/test": "^1.61.1",
        "@types/glob": "^7.2.0",
        "@types/lodash": "^4.17.1",
        "@types/mocha": "^10.0.10",
        "@typescript-eslint/eslint-plugin": "^6.4.0",
        "@typescript-eslint/parser": "^7.5.0",
        "@vitejs/plugin-react": "^4.3.0",
        "eslint": "^8.0.1",
        "eslint-config-prettier": "^8.5.0",
        "eslint-config-standard-with-typescript": "^43.0.1",
        "eslint-plugin-import": "^2.25.2",
        "eslint-plugin-n": "^15.0.0 || ^16.0.0 ",
        "eslint-plugin-prettier": "^4.2.1",
        "eslint-plugin-promise": "^6.0.0",
        "eslint-plugin-react": "^7.34.1",
        "glob": "^8.0.3",
        "husky": "^8.0.1",
        "i18next": "^21.8.16",
        "i18next-browser-languagedetector": "^6.1.4",
        "inversify": "^6.2.0",
        "lint-staged": "^13.0.3",
        "prettier": "^2.7.1",
        "reflect-metadata": "^0.1.13",
        "sass": "^1.83.0",
        "ts-node": "^10.9.1",
        "typescript": "^5.7.2",
        "vercel": "^56.4.1",
        "vite": "^6.0.0",
        "vite-plugin-checker": "^0.9.0",
        "vitepress": "^1.6.4",
        "vitest": "3.2.6"
    },
    "packageManager": "yarn@4.5.3",
    "peerDependencies": {
        "typescript": "*"
    }
}
