{
    "private": true,
    "workspaces": [
        "packages/*",
        "crafts/*"
    ],
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@mui/icons-material": "^6.5.0",
        "@mui/material": "^6.5.0",
        "@mui/system": "^7.3.11",
        "@mui/x-date-pickers": "^7.29.4",
        "@types/node": "^18",
        "@types/react": "^19",
        "@types/react-beautiful-dnd": "^13.1.8",
        "@types/react-color": "^3.0.13",
        "@types/react-dom": "^19",
        "@types/react-transition-group": "^4.4.12",
        "dayjs": "^1.11.23",
        "dexie": "^4.4.7",
        "eslint-plugin-react-hooks": "^4.6.2",
        "fflate": "^0.8.3",
        "lodash": "^4.18.1",
        "logisheets-core": "workspace:*",
        "logisheets-engine": "workspace:*",
        "logisheets-logician": "workspace:*",
        "logisheets-web": "workspace:*",
        "mobx": "^6.16.1",
        "mobx-react": "^9.2.2",
        "neverthrow": "^8.2.0",
        "numfmt": "2.5.2",
        "react": "^19",
        "react-beautiful-dnd": "^13.1.1",
        "react-color": "^2.19.3",
        "react-dom": "^19",
        "react-i18next": "^11.18.6",
        "react-select": "^5.10.2",
        "react-toastify": "^11.2.0",
        "react-transition-group": "^4.4.5",
        "rxjs": "^7.8.2",
        "web-vitals": "^2.1.4"
    },
    "scripts": {
        "build-craftsmith": "yarn workspace logisheets-craftsmith build",
        "build-crafts": "yarn build-craftsmith && ./crafts/build.sh",
        "build": "yarn build-crafts && vite build && ./publish-crafts.sh",
        "build:games": "CRAFT_DIST=games yarn build",
        "gen-bindings": "cargo run --package buildtools --bin generate --all-features",
        "lint": "eslint . -c .eslintrc.json --fix",
        "prepare": "husky install",
        "run-scripts": "ts-node scripts/index.ts",
        "start": "yarn run start:wasm",
        "start:dev": "vite",
        "start:wasm": "yarn run run-scripts && yarn run wasm && yarn workspace logisheets-engine build && vite",
        "test": "vitest run",
        "test:e2e": "playwright test",
        "test:e2e:headed": "playwright test --headed",
        "wasm": "yarn run wasm:server",
        "wasm:server": "wasm-pack build crates/wasms/server --out-dir ../../../packages/web/wasm --target web",
        "docs:dev": "vitepress dev docs",
        "docs:build": "vitepress build docs",
        "docs:preview": "vitepress preview docs"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@types/glob": "^7.2.0",
        "@types/lodash": "^4.17.27",
        "@types/mocha": "^10.0.10",
        "@typescript-eslint/eslint-plugin": "^6.21.0",
        "@typescript-eslint/parser": "^7.18.0",
        "@vitejs/plugin-react": "^4.7.0",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^8.10.2",
        "eslint-config-standard-with-typescript": "^43.0.1",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-n": "^15.7.0",
        "eslint-plugin-prettier": "^4.2.5",
        "eslint-plugin-promise": "^6.6.0",
        "eslint-plugin-react": "^7.37.5",
        "glob": "^8.1.0",
        "husky": "^8.0.3",
        "i18next": "^21.10.0",
        "i18next-browser-languagedetector": "^6.1.8",
        "lint-staged": "^13.3.0",
        "prettier": "^2.8.8",
        "sass": "^1.107.1",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.3",
        "vercel": "^65.9.0",
        "vite": "^6.4.5",
        "vite-plugin-checker": "^0.14.5",
        "vitepress": "^1.6.4",
        "vitest": "3.2.7"
    },
    "packageManager": "yarn@4.5.3",
    "peerDependencies": {
        "typescript": "*"
    }
}
