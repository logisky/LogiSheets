{
    "private": true,
    "workspaces": [
        "packages/*",
        "crafts/*"
    ],
    "dependencies": {
        "@emotion/cache": "^11.14.0",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@mui/icons-material": "^6.5.0",
        "@mui/material": "^6.5.0",
        "@mui/system": "^7.3.11",
        "@mui/x-date-pickers": "^7.29.4",
        "@types/node": "^22",
        "@types/react": "^19",
        "@types/react-beautiful-dnd": "^13.1.8",
        "@types/react-color": "^3.0.13",
        "@types/react-dom": "^19",
        "@types/react-transition-group": "^4.4.12",
        "dayjs": "^1.11.23",
        "dexie": "^4.4.7",
        "fflate": "^0.8.3",
        "lodash": "^4.18.1",
        "logisheets-core": "workspace:*",
        "logisheets-engine": "workspace:*",
        "logisheets-logician": "workspace:*",
        "logisheets-web": "workspace:*",
        "mobx": "^7.1.5",
        "mobx-react-lite": "^5.1.2",
        "neverthrow": "^8.2.0",
        "react": "^19",
        "react-beautiful-dnd": "^13.1.1",
        "react-color": "^2.19.3",
        "react-dom": "^19",
        "react-i18next": "^18.0.0",
        "react-select": "^5.10.2",
        "react-toastify": "^11.2.0",
        "react-transition-group": "^4.4.5",
        "rxjs": "^7.8.2"
    },
    "scripts": {
        "build-craftsmith": "yarn workspace logisheets-craftsmith build",
        "build-crafts": "yarn build-craftsmith && ./crafts/build.sh",
        "build": "yarn build-crafts && vite build && ./publish-crafts.sh",
        "build:games": "CRAFT_DIST=games yarn build",
        "gen-bindings": "cargo run --package buildtools --bin generate --all-features",
        "lint": "eslint . --fix",
        "run-scripts": "ts-node scripts/index.ts",
        "start": "yarn run start:wasm",
        "start:dev": "vite",
        "start:wasm": "yarn run run-scripts && yarn run wasm && yarn workspace logisheets-engine build && vite",
        "test": "vitest run",
        "test:e2e": "playwright test",
        "test:e2e:headed": "playwright test --headed",
        "wasm": "yarn run wasm:server",
        "wasm:server": "wasm-pack build crates/wasms/server --out-dir ../../../packages/web/wasm --target web",
        "docs:dev": "vitepress dev docs",
        "docs:build": "vitepress build docs",
        "docs:preview": "vitepress preview docs"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@playwright/test": "^1.65.0",
        "@types/lodash": "^4.17.27",
        "@types/mocha": "^10.0.10",
        "@vitejs/plugin-react": "^6.2.1",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.7",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "glob": "^14.0.4",
        "globals": "^17.14.0",
        "i18next": "^27.0.0",
        "prettier": "^3.9.10",
        "sass": "^1.108.1",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vercel": "^65.12.1",
        "vite": "^8.3.6",
        "vite-plugin-checker": "^0.14.5",
        "vitepress": "^1.6.4",
        "vitest": "5.1.0"
    },
    "packageManager": "yarn@4.5.3",
    "peerDependencies": {
        "typescript": "*"
    }
}
