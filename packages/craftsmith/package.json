{
    "name": "logisheets-craftsmith",
    "version": "0.1.0",
    "description": "CLI for LogiSheets crafts — scaffold, check, build and pack a craft, generating the capability manifest Watson uses to discover and invoke its tools.",
    "type": "module",
    "bin": {
        "craftsmith": "./dist/cli.js"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./authoring": {
            "types": "./authoring.d.ts"
        }
    },
    "scripts": {
        "build": "esbuild src/cli.ts src/index.ts --bundle --format=esm --platform=node --packages=external --outdir=dist --out-extension:.js=.js && tsc -p tsconfig.json --noEmit false --declaration --emitDeclarationOnly --outDir dist --rootDir src",
        "check": "node dist/cli.js check",
        "prepublishOnly": "yarn build"
    },
    "author": "Jeremy He",
    "license": "MIT",
    "dependencies": {
        "esbuild": "^0.21.0",
        "fflate": "^0.8.2",
        "typescript": "^6.0.0"
    },
    "files": [
        "dist",
        "authoring.d.ts"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/logisky/LogiSheets.git",
        "directory": "packages/craftsmith"
    },
    "homepage": "https://github.com/logisky/LogiSheets/blob/main/docs/craft/writing-a-craft.md",
    "keywords": [
        "logisheets",
        "craft",
        "spreadsheet",
        "plugin"
    ],
    "engines": {
        "node": ">=18"
    },
    "devDependencies": {
        "@types/node": "^18"
    }
}
