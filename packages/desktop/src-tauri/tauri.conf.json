{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LogiSheets",
  "version": "0.1.0",
  "identifier": "com.logisheets.desktop",
  "build": {
    "frontendDist": "../../../dist",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LogiSheets",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
