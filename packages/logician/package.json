{
    "name": "logisheets-logician",
    "version": "1.12.1",
    "description": "AI agent tools for LogiSheets — platform-agnostic LLM tool definitions, prompts, and skills for operating a real spreadsheet engine. Powers Watson (the in-app assistant) and logisheets-mcp; reusable in any agent host.",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "node": "./dist/index.node.js",
            "default": "./dist/index.js"
        }
    },
    "author": "Jeremy He",
    "license": "MIT",
    "scripts": {
        "build": "tsc && yarn build:node",
        "build:node": "esbuild src/index.ts --bundle --format=esm --platform=node --external:logisheets-core --external:logisheets --outfile=dist/index.node.js",
        "prepack": "yarn build"
    },
    "dependencies": {
        "logisheets-core": "^1.12.1",
        "logisheets-web": "^1.12.1"
    },
    "devDependencies": {
        "esbuild": "^0.21.0",
        "typescript": "^6.0.0"
    },
    "files": [
        "dist"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/logisky/LogiSheets.git",
        "directory": "packages/logician"
    },
    "bugs": {
        "url": "https://github.com/logisky/LogiSheets/issues"
    },
    "homepage": "https://github.com/logisky/LogiSheets",
    "keywords": [
        "logisheets",
        "spreadsheet",
        "llm",
        "agent",
        "tools",
        "mcp",
        "xlsx",
        "excel",
        "ai"
    ]
}
