{
    "name": "logisheets-runtime",
    "version": "1.12.1",
    "description": "Headless LogiSheets spreadsheet runtime for Node — logisheets-core wired to the Node WASM engine. The Node counterpart of the browser app.",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "prepack": "yarn build"
    },
    "files": [
        "dist"
    ],
    "author": "Jeremy He",
    "license": "MIT",
    "keywords": [
        "spreadsheet",
        "xlsx",
        "excel",
        "headless",
        "nodejs",
        "server",
        "wasm",
        "rust",
        "formula",
        "workbook"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/logisky/LogiSheets.git",
        "directory": "packages/runtime"
    },
    "bugs": {
        "url": "https://github.com/logisky/LogiSheets/issues"
    },
    "homepage": "https://github.com/logisky/LogiSheets",
    "dependencies": {
        "logisheets": "^1.12.1",
        "logisheets-core": "^1.12.1"
    },
    "devDependencies": {
        "@types/node": "^18",
        "typescript": "^6.0.0",
        "vitest": "3.2.6"
    }
}
