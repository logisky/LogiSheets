{
  "name": "logisheets-web",
  "author": "Jeremy He<yiliang.he@qq.com>",
  "license": "MIT",
  "version": "1.16.1",
  "description": "Browser SDK for LogiSheets — a Rust + WebAssembly spreadsheet engine that reads, edits, and writes real .xlsx (Excel) files (formulas, styles, and structure preserved) entirely in the browser.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pure": {
      "types": "./dist/src/pure.d.ts",
      "node": "./dist/pure.node.js",
      "default": "./dist/src/pure.js"
    },
    "./*": "./dist/*"
  },
  "scripts": {
    "wasm-build": "wasm-pack build ../../crates/wasms/server --out-dir ../../../packages/web/wasm --target web && rm -f wasm/.gitignore",
    "build": "yarn wasm-build && npx tsc && rm -rf dist/wasm && cp -R wasm dist/ && yarn build:pure",
    "build:pure": "npx esbuild src/pure.ts --bundle --format=esm --platform=node --outfile=dist/pure.node.js",
    "test": "npx vitest run",
    "prepublishOnly": "yarn wasm-build && yarn build",
    "prepare": "yarn wasm-build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/logisky/LogiSheets.git"
  },
  "keywords": [
    "xlsx",
    "excel",
    "spreadsheet",
    "spreadsheet-engine",
    "wasm",
    "webassembly",
    "rust",
    "browser",
    "formula",
    "ooxml"
  ],
  "files": [
    "dist"
  ],
  "bugs": {
    "url": "https://github.com/logisky/LogiSheets/issues"
  },
  "homepage": "https://github.com/logisky/LogiSheets"
}
